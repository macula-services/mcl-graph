%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_graph.
%%
%% An embeddable relational-graph database (CozoDB) as a mesh service: each
%% instance keeps its own graph on local disk and answers resolve/learn/narrate
%% calls over the mesh.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0, so mcl_om starts no reckon-db store: the graph lives in
    %% CozoDB, which this repo's own NIF opens. 0.26.6: an asserted_by proof
    %% decoded off the wire verifies (0.26.5 refused every one).
    %% 0.27: no barrel_docdb, so no erlang rocksdb build; the boot claim is
    %% labelled from MCL_SERVICE_NAME and MCL_BOX.
    {mcl_om, "~> 0.27"},
    %% The 12.x wire: every text value arrives as {text, Bin}, peer maps carry
    %% no atoms, and the caller of a CALL is its wire-authenticated node id.
    {macula, "~> 12.1"}
]}.

%% The CozoDB NIF is built from source on every compile, never fetched. The
%% hook resolves the repo root whether this is the top-level project or a
%% dependency of another one.
{pre_hooks, [
    {compile, "sh -c 'B=\"${REBAR_DEPS_DIR}/mcl_graph\"; [ -f \"$B/native/build-nif.sh\" ] || B=\".\"; sh \"$B/native/build-nif.sh\" \"$B\"'"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_graph, "0.1.0"}, [mcl_graph, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        %% meck stands in for the store and the mesh in the desk tests, so each
        %% case sees exactly what the desk hands on.
        {deps, [{meck, "~> 1.2"}]},
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

{dialyzer, [
    {warnings, [no_unknown]},
    {plt_extra_apps, [mcl_om, macula]}
]}.
